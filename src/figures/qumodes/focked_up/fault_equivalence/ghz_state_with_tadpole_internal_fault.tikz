\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=gn] (0) at (1, 0) {};
		\node [style=none] (1) at (2.5, 1) {};
		\node [style=none] (2) at (2.5, -1) {};
		\node [style=none] (3) at (2, 0.2) {$\vdots$};
		\node [style=gn] (4) at (-2.5, 0) {};
		\node [style={gn_phase}] (10) at (-1.5, 0) {$\chi_{q_1}$};
		\node [style={rn_phase}] (11) at (0, 0) {$\chi_{p_1}$};
