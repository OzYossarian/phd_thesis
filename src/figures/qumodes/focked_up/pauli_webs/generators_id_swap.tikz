\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-4, 0) {};
		\node [style=none] (1) at (-2, 0) {};
		\node [style=none] (6) at (2, 0.75) {};
		\node [style=none] (7) at (4, -0.75) {};
		\node [style=none] (8) at (4, 0.75) {};
		\node [style=none] (9) at (2, -0.75) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (0.center) to (1.center);
		\draw [in=-180, out=0] (9.center) to (8.center);
		\draw [in=-180, out=0] (6.center) to (7.center);
	\end{pgfonlayer}
\end{tikzpicture}
