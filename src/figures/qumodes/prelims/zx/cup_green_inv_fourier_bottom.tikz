\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=gn] (0) at (0, 0) {};
		\node [style=none] (1) at (1, 1) {};
		\node [style=none] (2) at (1, -1) {};
		\node [style={fn_phase}] (3) at (1, -1) {$i^{\isarg{n}}$};
		\node [style=none] (4) at (2, -1) {};
		\node [style=none] (5) at (2, 1) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [in=180, out=75] (0) to (1.center);
		\draw [in=180, out=-75] (0) to (2.center);
		\draw (2.center) to (4.center);
		\draw (1.center) to (5.center);
	\end{pgfonlayer}
\end{tikzpicture}
