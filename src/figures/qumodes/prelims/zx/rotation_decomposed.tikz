\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-4.75, 0) {};
		\node [style=none] (1) at (4.75, 0) {};
		\node [style={gn_phase}] (4) at (-3, 0) {$e^{i \pi \isarg{q}^2 \tan({\frac{\theta}{2}})}$};
		\node [style={rn_phase}] (5) at (0, 0) {$e^{i \pi \isarg{p}^2 \sin(\theta)}$};
		\node [style={gn_phase}] (6) at (3, 0) {$e^{i \pi \isarg{q}^2 \tan({\frac{\theta}{2}})}$};
