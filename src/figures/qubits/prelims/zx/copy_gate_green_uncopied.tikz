\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style={rn_phase}] (0) at (0, 0) {$\alpha$};
		\node [style=none] (3) at (1.5, 1) {};
		\node [style=none] (4) at (1.5, -1) {};
		\node [style=none] (5) at (1.25, 0) {\raisebox{1.3ex}{$\vdots$}};
		\node [style=none] (6) at (-2, 0) {};
		\node [style={gn_phase}] (7) at (-1, 0) {$\pi$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [bend left] (0) to (3.center);
		\draw [bend right] (0) to (4.center);
		\draw (0) to (6.center);
	\end{pgfonlayer}
\end{tikzpicture}
