\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style={gn_phase}] (0) at (0, 0) {$-\alpha$};
		\node [style=none] (3) at (1.5, 1) {};
		\node [style=none] (4) at (1.5, -1) {};
		\node [style=none] (5) at (1.5, 0) {\raisebox{1.3ex}{$\vdots$}};
		\node [style=none] (6) at (-1.5, 0) {};
		\node [style={rn_phase}] (7) at (1.5, 1) {$\pi$};
		\node [style=none] (8) at (2.25, 1) {};
		\node [style=none] (9) at (2.25, -1) {};
		\node [style={rn_phase}] (10) at (1.5, -1) {$\pi$};
		\node [style=none] (11) at (-2.5, 0) {$e^{i\alpha}$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [bend left] (0) to (3.center);
		\draw [bend right] (0) to (4.center);
		\draw (0) to (6.center);
		\draw (8.center) to (3.center);
		\draw (9.center) to (4.center);
	\end{pgfonlayer}
\end{tikzpicture}
