\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=gn] (0) at (-0.75, 0.5) {};
		\node [style=rn] (1) at (0.75, -0.5) {};
		\node [style=none] (2) at (-1.5, 0.5) {};
		\node [style=none] (3) at (0, 1) {};
		\node [style=none] (4) at (0, -1) {};
		\node [style=none] (5) at (1.5, -0.5) {};
		\node [style=none] (6) at (0, 0) {};
		\node [style=none] (7) at (-1.5, -1) {};
		\node [style=none] (8) at (1.5, 1) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (2.center) to (0);
		\draw [in=-180, out=60] (0) to (3.center);
		\draw [in=-120, out=0] (4.center) to (1);
		\draw (1) to (5.center);
		\draw [in=180, out=-60] (0) to (6.center);
		\draw [in=360, out=120] (1) to (6.center);
		\draw (7.center) to (4.center);
		\draw (3.center) to (8.center);
	\end{pgfonlayer}
\end{tikzpicture}
