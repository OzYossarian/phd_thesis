\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=gn] (0) at (-0.5, 0.5) {};
		\node [style=rn] (1) at (-0.5, -0.5) {};
		\node [style=none] (2) at (-1.5, 0.5) {};
		\node [style=none] (3) at (0, 0.5) {};
		\node [style=none] (4) at (-1.5, -0.5) {};
		\node [style=none] (5) at (0, -0.5) {};
		\node [style=none] (6) at (1.5, 0.5) {};
		\node [style=none] (7) at (1.5, -0.5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (2.center) to (3.center);
		\draw (4.center) to (5.center);
		\draw (0) to (1);
		\draw [in=-180, out=0, looseness=0.75] (5.center) to (6.center);
		\draw [in=-180, out=0, looseness=0.75] (3.center) to (7.center);
	\end{pgfonlayer}
\end{tikzpicture}
