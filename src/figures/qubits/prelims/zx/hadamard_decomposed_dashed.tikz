\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (2) at (-2.25, 1) {};
		\node [style=none] (3) at (-2.25, -1) {};
		\node [style=none] (7) at (2.25, 1) {};
		\node [style=none] (8) at (2.25, -1) {};
		\node [style=none] (9) at (-0.75, -1) {};
		\node [style=none] (10) at (-0.75, 1) {};
		\node [style=none] (11) at (0.75, 1) {};
		\node [style=none] (12) at (0.75, -1) {};
		\node [style=none] (13) at (-2.25, 0) {};
		\node [style=none] (14) at (2.25, 0) {};
		\node [style={gn_phase}] (15) at (-1.5, 0) {$\frac{\pi}{2}$};
		\node [style={rn_phase}] (16) at (0, 0) {$\frac{\pi}{2}$};
		\node [style={gn_phase}] (17) at (1.5, 0) {$\frac{\pi}{2}$};
