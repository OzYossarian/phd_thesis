\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (3) at (-1.5, 0) {};
		\node [style=none] (4) at (1.5, 0) {};
		\node [style=hdot] (5) at (0, 0) {};
